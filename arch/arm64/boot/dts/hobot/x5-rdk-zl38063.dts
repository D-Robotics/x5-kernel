/*
 * dts for RDK X5 with ZL38063 audio codec and TPA2016D2 amplifier
 *
 * Copyright (C) 2024 D-Robotics, Inc.
 */

/dts-v1/;
#include "x5-rdk.dtsi"

/ {
	model = "D-Robotics RDK X5 V1.0 with ZL38063";

	leds {
		status = "okay";
		compatible = "gpio-leds";

		act_led: led-act {
			label = "ACT";
			gpios = <&dsp_gpio_porta 14 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "heartbeat";
		};
	};

	zl38063_sound: zl38063-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "zl38063-audio";
		simple-audio-card,mclk-fs = <256>;

		simple-audio-card,dai-link@0 {
			format = "i2s";
			cpu {
				sound-dai = <&dw_i2s1 0>;
			};
			codec {
				sound-dai = <&zl38xx0 0>;
			};
		};
	};
};

&lsio_iomuxc {
	lsio_gpio0_13: lsio_gpio0_13 {
		horizon,pins = <
			LSIO_UART4_TX	LSIO_PINMUX_3 BIT_OFFSET26	MUX_ALT2	&pconf_output_high
		>;
	};
};

//wifi antenna Onboard
&dsp_gpio_porta {
	pinctrl-names = "default";
	pinctrl-0 = < &dsp_gpio0_15
				&dsp_gpio0_16
				&dsp_gpio0_17
				&dsp_gpio0_18
			>;
};

&ls_gpio0_porta {
	pinctrl-names = "default";
	pinctrl-0 = <&lsio_gpio0_13>;//USB HUB RESET high
};

&spi5 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_spi5 &lsio_gpio0_7 &lsio_gpio0_12>;
	dma-names = "tx", "rx";
	dmas = <&axi_dmac 31>, <&axi_dmac 30>;

	tcan4x5x: tcan4x5x@0 {
		compatible = "ti,tcan4x5x";
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		spi-max-frequency = <18000000>;
		bosch,mram-cfg = <0x0 0 0 10 0 0 10 10>;
		interrupt-parent = <&ls_gpio0_porta>;
		interrupts = <12 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&ls_gpio0_porta 7 GPIO_ACTIVE_HIGH>;
	};
};

&vin_vcon0 {
	status = "okay";
	/* camera sensor
	 * reset gpio:	LSIO_GPIO1_PIN6:	353
	 * lpwm      :  LSIO_SPI3_SCLK  :   pinctrl_lpwm1_0
	 */
	pinctrl-names = "default";
	pinctrl-0 = <&lsio_gpio1_6>;
	gpio_oth = <353>;   // reset gpio
	bus = <6>; // i2c bus
	lpwm_chn = <4>;
};

&vin_vcon1 {
	status = "okay";
	// use same sensor gpio with vcon0 and i2c bus
	bus = <6>;
};

&vin_vcon2 {
	status = "okay";
	/* camera sensor
	 * reset gpio:	LSIO_GPIO1_PIN4:	351
	 * lpwm      :  LSIO_SPI3_SSN  :    pinctrl_lpwm1_1
	 */
	pinctrl-names = "default";
	pinctrl-0 = <&lsio_gpio1_4>;
	gpio_oth = <351>;   // reset gpio
	bus = <4>;  // i2c bus
	lpwm_chn = <5>;
};

&vin_vcon3 {
	status = "okay";
	// use same sensor gpio with vcon2 and i2c bus
	bus = <4>;
};

/* Disable original audio path */
&sound_machine {
	status = "disabled";
};

&es8326 {
	status = "disabled";
};

&dw_i2s0 {
	status = "disabled";
};

&duplex_card {
	status = "disabled";
};

&snd0 {
	status = "disabled";
};

/* Enable ZL38063 audio path */
&dw_i2s1 {
	status = "okay";
	#sound-dai-cells = <1>;
	dwc-master = <1>;
};

&i2c7 {
	zl38xx0: zl38xx0@45 {
		compatible = "microsemi,zl38xx0";
		reg = <0x45>;
		#sound-dai-cells = <1>;
		status = "okay";
	};

	tpa2016d2: tpa2016d2@58 {
		compatible = "ti,tpa2016d2";
		#sound-dai-cells = <0>;
		reg = <0x58>;
		status = "okay";
	};
};

&emmc {
	status = "okay";
	fixed-emmc-driver-type = <2>;
};
